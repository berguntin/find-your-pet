{
    "name": "nuxt-app",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "reload": "nuxt dev --reload",
        "prettier": "prettier --write .",
        "typecheck": "nuxi typecheck",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "db:migrate": "dbmate --env NUXT_DATABASE_URL --migrations-dir server/db/migrations --no-dump-schema --wait up",
        "db:rollback": "dbmate --env NUXT_DATABASE_URL --migrations-dir server/db/migrations --no-dump-schema rollback",
        "db:new": "dbmate --migrations-dir server/db/migrations new"
    },
    "dependencies": {
        "@nuxt/content": "^2.13.4",
        "@nuxt/icon": "1.7.0",
        "@nuxtjs/i18n": "^9.0.0-rc.2",
        "@nuxtjs/tailwindcss": "6.12.2",
        "@tailwindcss/typography": "^0.5.15",
        "@upstash/ratelimit": "^2.2.0",
        "@upstash/redis": "^1.39.0",
        "@vercel/analytics": "^1.4.1",
        "@vercel/functions": "^3.10.1",
        "@vercel/speed-insights": "^1.1.0",
        "@vueuse/head": "2.0.0",
        "cloudinary": "^2.11.0",
        "consola": "^3.4.2",
        "h3": "^1.15.11",
        "lucide-vue-next": "0.456.0",
        "nuxt": "3.14.159",
        "nuxt-swiper": "1.2.2",
        "openai": "^7.39.0",
        "postgres": "^3.4.9",
        "vue": "latest",
        "vue-router": "latest",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@nuxt/eslint-config": "^0.7.6",
        "@nuxtjs/i18n": "^9.0.0",
        "@vitest/coverage-v8": "^2.1.9",
        "daisyui": "^4.12.14",
        "dbmate": "^2.37.0",
        "eslint": "^9.39.5",
        "prettier": "^2.0.0",
        "typescript": "~5.7.3",
        "vitest": "^2.1.9",
        "vue-tsc": "^2.2.12"
    }
}
