# Supply-chain hardening (needs npm >= 11.16; older npm ignores these keys, so engine-strict enforces the version).
engine-strict=true
# Only resolve versions published at least 7 days ago, so a compromised release has time to be caught and pulled.
min-release-age=7
# Fail the install if a dependency has an install script that is not reviewed in package.json "allowScripts".
strict-allow-scripts=true
