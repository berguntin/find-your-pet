# Postgres. In Docker Compose the host is `db`; on Vercel use Supabase's pooler URL (transaction mode).
NUXT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pets?sslmode=disable
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pets

# Bearer token for admin-only actions from scripts (moderate, edit, delete). Leave empty to disable it.
NUXT_ADMIN_TOKEN=

# Admin panel (/admin): Google sign-in, only for the comma-separated emails below.
# Create an OAuth client (Web application) in Google Cloud with the redirect URI <base url>/auth/google.
NUXT_ADMIN_EMAILS=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# At least 32 characters; seals the session cookie. Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Bearer token for internal endpoints called by schedulers (outbox, image cleanup). Set CRON_SECRET to the
# same value on Vercel so Vercel Cron can call them too.
NUXT_INTERNAL_TOKEN=

# Cloudinary: the browser uploads images directly with a signature generated by the server.
NUXT_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=
NUXT_CLOUDINARY_FOLDER=pets

# OpenAI: pre-fills the report form from the photo and moderates reports (Decisions API).
# Leave empty to disable both: reports are then published WITHOUT moderation (development only).
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_DESCRIBER_MODEL=gpt-4o-mini
NUXT_OPENAI_MODERATION_MODEL=gpt-6-luna

# Gemini multimodal embeddings for image search and semantic text search ("perro negro").
# Leave empty to disable both: image search answers 503 and text search uses keywords only.
NUXT_GEMINI_API_KEY=
NUXT_GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
# Similarity calibration (see scripts/eval-embeddings.ts): below the floor results are hidden,
# from the ceiling they show as 100%.
NUXT_IMAGE_SEARCH_MATCH_FLOOR=0.6
NUXT_IMAGE_SEARCH_MATCH_CEILING=0.95
# Same for text queries, against report texts and against photos (provisional values).
NUXT_SEMANTIC_SEARCH_TEXT_FLOOR=0.55
NUXT_SEMANTIC_SEARCH_TEXT_CEILING=0.85
NUXT_SEMANTIC_SEARCH_IMAGE_FLOOR=0.25
NUXT_SEMANTIC_SEARCH_IMAGE_CEILING=0.45

# Upstash Redis for rate limiting. Leave empty to disable it. The Vercel integration's
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN variables are accepted too.
NUXT_UPSTASH_URL=
NUXT_UPSTASH_TOKEN=

NUXT_PUBLIC_BASE_URL=http://localhost:8000
