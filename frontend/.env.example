# Postgres. In Docker Compose the host is `db`; on Vercel use Supabase's pooler URL (transaction mode).
NUXT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pets?sslmode=disable
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pets

# Bearer token for admin-only actions (mark as reunited, delete). Leave empty to disable them.
NUXT_ADMIN_TOKEN=

# Cloudinary: the browser uploads images directly with a signature generated by the server.
NUXT_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=
NUXT_CLOUDINARY_FOLDER=pets

# OpenAI: pre-fills the report form from the photo. Leave empty to disable it.
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_DESCRIBER_MODEL=gpt-4o-mini

NUXT_PUBLIC_BASE_URL=http://localhost:8000
